<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WeeklyScreenPen</RootNamespace>
    <AssemblyName>WeeklyScreenPen</AssemblyName>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>WeeklyScreenPen</Product>
    <AssemblyTitle>WeeklyScreenPen</AssemblyTitle>
    <Description>Screen drawing overlay pen</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\icon.ico" LogicalName="WeeklyScreenPen.Assets.icon.ico" />
  </ItemGroup>

</Project>
